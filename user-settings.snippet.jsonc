// ─────────────────────────────────────────────────────────────────────────────
// این بلوک را در «تنظیمات کاربر» Zed ادغام کنید (نه داخل پروژه):
//   Command Palette  →  zed: open settings file
// کلیدهای موجود را پاک نکنید؛ فقط این کلیدها را merge کنید.
// کلید API را هیچ‌وقت اینجا نگذارید:  agent: open settings → LLM Providers → zai → API key
// (یا متغیر محیطی ZAI_API_KEY قبل از اجرای Zed از ترمینال)
// ─────────────────────────────────────────────────────────────────────────────
{
  "language_models": {
    "openai_compatible": {
      "zai": {
        // اشتراک GLM Coding Plan  →  https://api.z.ai/api/coding/paas/v4
        // کلید پرداخت به‌ازای توکن →  https://api.z.ai/api/paas/v4
        // (کلید هر کدام فقط روی endpoint خودش کار می‌کند؛ اشتباه = 401)
        "api_url": "https://api.z.ai/api/coding/paas/v4",
        "available_models": [
          {
            // نام دقیق مدل را با این دستور چک کنید و جدیدترین GLM موجود را بگذارید:
            //   curl -s https://api.z.ai/api/coding/paas/v4/models -H "Authorization: Bearer $ZAI_API_KEY"
            "name": "glm-5.1",
            "display_name": "GLM 5.1 (Z.ai)",
            "max_tokens": 200000,
            "max_output_tokens": 32768,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          }
        ]
      }
    }
  },

  "agent": {
    // بعد از ذخیره‌ی این فایل، مدل را یک بار از انتخاب‌گر مدل داخل Agent Panel انتخاب کنید
    // تا Zed خودش agent.default_model را درست بنویسد.

    "auto_compact": { "enabled": true, "threshold": "80%" },

    // کد/مهاجرت دیتابیس باید قطعی باشد، نه خلاق
    "model_parameters": [{ "model": "glm-5.1", "temperature": 0.2 }],

    "commit_message_instructions": "Use Conventional Commits: <type>(<scope>): <summary>. Types: feat, fix, refactor, test, docs, chore. English, imperative, max 72 chars in the first line; body explains why.",

    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^(uv run |python -m )?(ruff|pytest|mypy|pyright)\\b" },
            { "pattern": "^git\\s+(status|diff|log|show|branch|blame)\\b" },
            { "pattern": "^alembic\\s+(heads|history|branches)\\b" },
            { "pattern": "^(ls|head|tail|grep|rg|find|tree|wc)\\b" }
          ],
          "always_confirm": [
            { "pattern": "^alembic\\s+" },
            { "pattern": "^docker" },
            { "pattern": "^(pip|pip3|uv|poetry)\\s+(install|add|remove|sync)" },
            { "pattern": "^git\\s+(add|commit|checkout|switch|restore|stash|merge|rebase|reset|clean|cherry-pick)" },
            { "pattern": "^python3?\\s" }
          ],
          "always_deny": [
            { "pattern": "git\\s+push" },
            { "pattern": "reset_db|reset_alembic|res_db|restore_backup" },
            { "pattern": "(drop|truncate)\\s+(table|database|schema)" },
            { "pattern": "docker\\s+(compose\\s+)?down\\b.*(-v|--volumes)" },
            { "pattern": "docker\\s+volume\\s+(rm|prune)" },
            { "pattern": "rm\\s+-[a-zA-Z]*r" },
            { "pattern": "(^|\\s)\\.env(\\s|$)" },
            { "pattern": "sudo\\s" },
            { "pattern": "(curl|wget)[^|]*\\|\\s*(sh|bash)" }
          ]
        },
        "edit_file": {
          "default": "allow",
          "always_confirm": [
            { "pattern": "(^|/)alembic/versions/" },
            { "pattern": "(^|/)docker-compose\\.ya?ml$" },
            { "pattern": "(^|/)requirements.*\\.txt$" },
            { "pattern": "(^|/)AGENTS\\.md$" }
          ],
          "always_deny": [
            { "pattern": "(^|/)\\.env$" },
            { "pattern": "(^|/)\\.env\\.(local|dev|prod|production|staging)$" },
            { "pattern": "\\.(pem|key)$" }
          ]
        },
        "delete_path": { "default": "confirm" },
        "fetch": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^https://(docs\\.pasarguard\\.org|deepwiki\\.com/PasarGuard|github\\.com/(PasarGuard|Gozargah|hiddify)|raw\\.githubusercontent\\.com/(PasarGuard|Gozargah|hiddify)|hiddify\\.com|core\\.telegram\\.org|docs\\.aiogram\\.dev|docs\\.sqlalchemy\\.org|alembic\\.sqlalchemy\\.org)" }
          ]
        }
      }
    }
  }
}
